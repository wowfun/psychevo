{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppToolDefinition": {
      "properties": {
        "description": {
          "type": "string"
        },
        "executionMode": {
          "$ref": "#/definitions/AppToolExecutionMode"
        },
        "name": {
          "type": "string"
        },
        "parameters": true,
        "timeoutMs": {
          "allOf": [
            {
              "$ref": "#/definitions/JsonSafeU64"
            }
          ],
          "default": 300000
        }
      },
      "required": [
        "description",
        "executionMode",
        "name",
        "parameters"
      ],
      "type": "object"
    },
    "AppToolExecutionMode": {
      "enum": [
        "parallel",
        "sequential"
      ],
      "type": "string"
    },
    "JsonSafeU64": {
      "maximum": 9007199254740991.0,
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "properties": {
    "approvalHandler": {
      "default": false,
      "type": "boolean"
    },
    "clarifyHandler": {
      "default": false,
      "type": "boolean"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/definitions/AppToolDefinition"
      },
      "type": "array"
    }
  },
  "title": "AppToolRegisterParams",
  "type": "object"
}
