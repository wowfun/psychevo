{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FrameworkTurnKind": {
      "enum": [
        "root",
        "delegated_child"
      ],
      "type": "string"
    },
    "GatewayLocalOperationView": {
      "enum": [
        "shell"
      ],
      "type": "string"
    },
    "JsonSafeI64": {
      "maximum": 9007199254740991.0,
      "minimum": -9007199254740991.0,
      "type": "integer"
    },
    "JsonSafeU64": {
      "maximum": 9007199254740991.0,
      "minimum": 0.0,
      "type": "integer"
    },
    "ThreadActivityView": {
      "oneOf": [
        {
          "properties": {
            "activityId": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/definitions/FrameworkTurnKind"
            },
            "owner": {
              "enum": [
                "framework_turn"
              ],
              "type": "string"
            },
            "queuedTurns": {
              "$ref": "#/definitions/JsonSafeU64"
            },
            "turnId": {
              "type": "string"
            }
          },
          "required": [
            "activityId",
            "kind",
            "owner",
            "queuedTurns",
            "turnId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "activityId": {
              "type": "string"
            },
            "operation": {
              "$ref": "#/definitions/GatewayLocalOperationView"
            },
            "owner": {
              "enum": [
                "gateway_local"
              ],
              "type": "string"
            }
          },
          "required": [
            "activityId",
            "operation",
            "owner"
          ],
          "type": "object"
        },
        {
          "properties": {
            "activityId": {
              "type": "string"
            },
            "owner": {
              "enum": [
                "foreign"
              ],
              "type": "string"
            },
            "ownerId": {
              "type": "string"
            },
            "ownerSurface": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "activityId",
            "owner",
            "ownerId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "activeTurnId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "activities": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ThreadActivityView"
      },
      "type": "array"
    },
    "frameworkRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "leaseExpiresAtMs": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonSafeI64"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownerSurface": {
      "type": [
        "string",
        "null"
      ]
    },
    "queuedTurns": {
      "$ref": "#/definitions/JsonSafeU64"
    },
    "running": {
      "type": "boolean"
    },
    "startedAtMs": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonSafeI64"
        },
        {
          "type": "null"
        }
      ]
    },
    "takeoverState": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAtMs": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonSafeI64"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "queuedTurns",
    "running"
  ],
  "title": "GatewayActivityView",
  "type": "object"
}
