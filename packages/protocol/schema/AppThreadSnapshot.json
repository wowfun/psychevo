{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppPendingInteraction": {
      "properties": {
        "interactionId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "payload": true,
        "requestedAtMs": {
          "$ref": "#/definitions/JsonSafeI64"
        },
        "resolution": true,
        "resolvedAtMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/JsonSafeI64"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "interactionId",
        "kind",
        "payload",
        "requestedAtMs",
        "status",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "AppThreadItem": {
      "properties": {
        "accounting": true,
        "message": true,
        "metadata": true,
        "sessionSeq": {
          "$ref": "#/definitions/JsonSafeI64"
        },
        "usage": true
      },
      "required": [
        "message",
        "sessionSeq"
      ],
      "type": "object"
    },
    "JsonSafeI64": {
      "maximum": 9007199254740991.0,
      "minimum": -9007199254740991.0,
      "type": "integer"
    }
  },
  "properties": {
    "activeTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "cwd": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/definitions/AppThreadItem"
      },
      "type": "array"
    },
    "messageCount": {
      "$ref": "#/definitions/JsonSafeI64"
    },
    "pendingInteractions": {
      "default": [],
      "items": {
        "$ref": "#/definitions/AppPendingInteraction"
      },
      "type": "array"
    },
    "source": {
      "type": "string"
    },
    "startedAtMs": {
      "$ref": "#/definitions/JsonSafeI64"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "toolCallCount": {
      "$ref": "#/definitions/JsonSafeI64"
    },
    "updatedAtMs": {
      "$ref": "#/definitions/JsonSafeI64"
    }
  },
  "required": [
    "archived",
    "cwd",
    "id",
    "messageCount",
    "source",
    "startedAtMs",
    "toolCallCount",
    "updatedAtMs"
  ],
  "title": "AppThreadSnapshot",
  "type": "object"
}
