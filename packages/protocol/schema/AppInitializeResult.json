        "name",
        "version"
      ],
      "type": "object"
    },
    "AppServerCapabilities": {
      "properties": {
        "customTools": {
          "type": "boolean"
        },
        "eventReplay": {
          "type": "string"
        },
        "interactions": {
          "type": "boolean"
        },
        "threads": {
          "type": "boolean"
        },
        "turns": {
          "type": "boolean"
        }
      },
      "required": [
        "customTools",
        "eventReplay",
        "interactions",
        "threads",
        "turns"
      ],
      "type": "object"
    }
  },
  "properties": {
