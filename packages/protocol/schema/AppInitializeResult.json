    },
    "protocolMin": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "protocolVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "server": {
      "$ref": "#/definitions/AppProductInfo"
    }
  },
  "required": [
    "capabilities",
    "protocolMax",
    "protocolMin",
    "protocolVersion",
    "server"
