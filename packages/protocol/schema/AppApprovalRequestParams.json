      "type": "string"
    },
    "suggestedRule": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "toolCallId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
