        "requestedPath",
        "resolvedPath"
      ],
      "type": "object"
    },
    "AppMcpStartupApprovalRequest": {
      "properties": {
        "descriptorFingerprint": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      },
      "required": [
        "descriptorFingerprint",
        "server",
        "transport"
      ],
      "type": "object"
    }
  },
  "properties": {
    "allowAlways": {
      "type": "boolean"
    },
    "callId": {
      "type": "string"
    },
    "filesystem": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppFilesystemApprovalRequest"
        },
        {
          "type": "null"
        }
