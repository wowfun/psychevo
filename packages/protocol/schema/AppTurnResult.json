{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppTurnOutcome": {
      "enum": [
        "completed",
        "stopped",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "JsonSafeU64": {
      "maximum": 9007199254740991.0,
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "properties": {
    "contextLimit": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonSafeU64"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextSnapshot": true,
    "finalAnswer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/definitions/AppTurnOutcome"
    },
    "provider": {
      "type": "string"
    },
    "reasoningEffort": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedAgent": true,
    "selectedSkills": {
      "default": [],
      "items": true,
      "type": "array"
    },
    "terminalError": true,
    "terminalReason": true,
    "threadId": {
      "type": "string"
    },
    "toolFailures": {
      "$ref": "#/definitions/JsonSafeU64"
    },
    "warnings": {
      "default": [],
      "items": true,
      "type": "array"
    }
  },
  "required": [
    "finalAnswer",
    "model",
    "outcome",
    "provider",
    "threadId",
    "toolFailures"
  ],
  "title": "AppTurnResult",
  "type": "object"
}
