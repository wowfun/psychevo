{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppToolExecutionMode": {
      "enum": [
        "parallel",
        "sequential"
      ],
      "type": "string"
    },
    "JsonSafeU64": {
      "maximum": 9007199254740991.0,
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "properties": {
    "description": {
      "type": "string"
    },
    "executionMode": {
      "$ref": "#/definitions/AppToolExecutionMode"
    },
    "name": {
      "type": "string"
    },
    "parameters": true,
    "timeoutMs": {
      "allOf": [
        {
          "$ref": "#/definitions/JsonSafeU64"
        }
      ],
      "default": 300000
    }
  },
  "required": [
    "description",
    "executionMode",
    "name",
    "parameters"
  ],
  "title": "AppToolDefinition",
  "type": "object"
}
