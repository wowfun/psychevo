{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "desktop-shared",
  "description": "Commands shared by the Workbench and Floating Desktop windows.",
  "windows": ["workbench", "floating"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-floating-begin-region-picker",
    "allow-floating-capture-region",
    "allow-floating-capture-selection",
    "allow-gateway-connect",
    "allow-gateway-disconnect",
    "allow-gateway-send"
  ]
}
